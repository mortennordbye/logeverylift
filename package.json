{
  "name": "logeverylift",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "bash scripts/ai-bootstrap.sh",
    "dev": "echo 'ERROR: Use make dev instead. This project runs in containers only.' && exit 1",
    "build": "next build",
    "start": "next start",
    "start:migrate": "tsx scripts/migrate.ts && next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed-fake": "tsx scripts/seed-fake.ts",
    "db:reset-user": "tsx scripts/reset-user.ts",
    "db:cleanup-programs": "tsx scripts/cleanup-orphaned-cycle-programs.ts",
    "db:diagnose": "tsx scripts/diagnose.ts",
    "ai:smoke": "tsx scripts/ai-smoke.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:int": "vitest run --project integration",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm typecheck && pnpm lint && pnpm check:docs && pnpm test && pnpm test:int",
    "test:e2e": "playwright test",
    "e2e:serve": "bash scripts/e2e-serve.sh",
    "verify:full": "make verify-full",
    "test:coverage": "vitest run --coverage",
    "prepare": "lefthook install || true",
    "check:docs": "tsx scripts/check-doc-claims.ts",
    "art": "tsx --no-deprecation scripts/exercise-art.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/instrumentation": "0.300.0",
    "@opentelemetry/instrumentation-pg": "0.77.0",
    "@opentelemetry/resources": "2.7.0",
    "@opentelemetry/sdk-logs": "0.214.0",
    "@opentelemetry/sdk-metrics": "2.7.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@sentry/nextjs": "^10.50.0",
    "@serwist/next": "^9.5.13",
    "@vercel/otel": "2.1.3",
    "better-auth": "^1.7.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "^6.16.0",
    "mcp-handler": "^1.1.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "serwist": "^9.5.13",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "26.1.0",
    "lefthook": "^2.2.2",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
