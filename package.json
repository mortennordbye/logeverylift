{
  "name": "logeverylift",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "setup": "bash scripts/ai-bootstrap.sh",
    "dev": "echo 'ERROR: Use make dev instead. This project runs in containers only.' && exit 1",
    "build": "next build",
    "start": "next start",
    "start:migrate": "tsx scripts/migrate.ts && next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed-fake": "tsx scripts/seed-fake.ts",
    "db:reset-user": "tsx scripts/reset-user.ts",
    "db:cleanup-programs": "tsx scripts/cleanup-orphaned-cycle-programs.ts",
    "db:diagnose": "tsx scripts/diagnose.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "test:e2e": "playwright test",
    "verify:full": "pnpm verify && pnpm test:e2e",
    "test:coverage": "vitest run --coverage",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/server": "^2.0.0",
    "@sentry/nextjs": "^10.69.0",
    "@serwist/next": "^9.5.12",
    "better-auth": "^1.6.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^13.0.0",
    "lucide-react": "^1.30.0",
    "mcp-handler": "^2.1.0",
    "next": "16.3.0",
    "pg": "^8.22.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "serwist": "^9.5.12",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.11",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "lefthook": "^2.1.10",
    "shadcn": "^4.16.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
